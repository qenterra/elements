{
  "name": "elements",
  "version": "1.0.0",
  "private": true,
  "description": "A Chrome extension for hiding page elements, editing their visible text, and restyling them.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "icons": "node scripts/render-icons.mjs",
    "zip:chrome": "wxt zip --browser chrome",
    "release:archives": "npm run zip:chrome",
    "release:notes": "node scripts/release-notes.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:qa": "QA_ONLY=1 node scripts/capture-screenshots.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:all": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qds:doctor": "node scripts/audit-qds.mjs",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config playwright.site.config.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run verify:docs && npm run verify:icons && npm run verify:site && npm test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:site": "node scripts/verify-qds-bridge.mjs && node scripts/verify-site.mjs",
    "verify:release-artifacts": "node scripts/verify-build.mjs --release",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:repository": "node scripts/verify-repository.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
