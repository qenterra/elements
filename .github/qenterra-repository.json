{
  "$schema": "./qenterra-repository.schema.json",
  "allowed_root_paths": [
    ".nvmrc",
    ".oxlintrc.json",
    ".prettierignore",
    ".prettierrc.json",
    "entrypoints",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "playwright.site.config.ts",
    "public",
    "qds-consumer.json",
    "qds-exceptions.json",
    "qds-metric-exceptions.json",
    "scripts",
    "site",
    "src",
    "tests",
    "tsconfig.json",
    "vitest.config.ts",
    "wxt.config.ts"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra/elements/security/advisories/new",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "1.0.0",
  "default_branch": "main",
  "dependabot_ecosystem": "npm",
  "description": "A local-first Chrome extension for hiding page elements, editing visible text, and restyling websites.",
  "documentation_root": "docs",
  "ecosystem": "typescript-react-browser-extension",
  "exceptions": [],
  "github_features": {
    "discussions": false,
    "issues": true,
    "projects": false,
    "wiki": true
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra_repository_check.py",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DEVELOPMENT.md",
      "docs/TESTING.md",
      "docs/RELEASING.md",
      "docs/DEPENDENCIES.md",
      "docs/STYLE_GUIDE.md",
      "docs/TROUBLESHOOTING.md",
      "docs/GITHUB_SETTINGS.md",
      "docs/MAINTENANCE.md",
      "docs/decisions/README.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "CONTRIBUTING.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md",
      ".github/ISSUE_TEMPLATE/01-bug.yml",
      ".github/ISSUE_TEMPLATE/02-feature.yml",
      ".github/ISSUE_TEMPLATE/03-documentation.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/labels.yml",
      "README.md",
      "docs/UPDATES.md",
      "docs/wiki/Home.md",
      "docs/wiki/_Sidebar.md",
      "docs/wiki/_Footer.md",
      "docs/wiki/Getting-Started.md",
      "docs/wiki/Architecture.md",
      "docs/wiki/Development.md",
      "docs/wiki/Release-Process.md",
      "docs/wiki/Troubleshooting.md",
      "PRIVACY.md",
      "TERMS_OF_USE.md",
      "LICENSE"
    ],
    "standard_version": "1.2.0"
  },
  "homepage_url": "https://qenterra.github.io/elements/",
  "install_command": "node scripts/verify-repository.mjs",
  "license": "MIT",
  "merge_strategy": "squash",
  "minimum_requirements": "Chrome or a compatible Chromium browser for use; Node.js 22, npm, and Python 3.11 or later for source verification.",
  "overlays": ["github-wiki", "product-legal"],
  "primary_language": "English",
  "profile": "application",
  "project_name": "Elements",
  "published_artifacts": [
    {
      "manifest": "src/qds/qds-artifacts-manifest.json",
      "path": "site/qds-web.css",
      "purpose": "Static-site QDS token bridge consumed by the published Elements website",
      "review_trigger": "QDS token source, artifact generator, site integration, or pinned Design System version changes",
      "source": "src/qds/qds-tokens.source.css",
      "verification_command": "node scripts/verify-qds-artifacts.mjs"
    },
    {
      "manifest": "src/qds/qds-artifacts-manifest.json",
      "path": "src/qds/qds-tokens.css",
      "purpose": "Pinned QDS token stylesheet consumed by the browser extension source",
      "review_trigger": "QDS token source, artifact generator, extension integration, or pinned Design System version changes",
      "source": "src/qds/qds-tokens.source.css",
      "verification_command": "node scripts/verify-qds-artifacts.mjs"
    }
  ],
  "quick_start_command": "node scripts/verify-repository.mjs",
  "release_mode": "github-releases",
  "repository_name": "elements",
  "repository_url": "https://github.com/QenTerra/elements",
  "security_url": "https://github.com/QenTerra/elements/security/advisories/new",
  "standard_version": "1.2.0",
  "support_url": "https://github.com/QenTerra/elements/issues",
  "topics": [
    "qenterra",
    "browser-extension",
    "chrome-extension",
    "local-first",
    "manifest-v3",
    "react",
    "typescript",
    "web-customization"
  ],
  "verification_command": "node scripts/verify-repository.mjs",
  "version_scheme": "semver",
  "version_source": "package.json",
  "version_tag_prefix": "v",
  "visibility": "public",
  "wiki_source": "docs/wiki"
}
